# Local development template. Copy to .env and never commit real credentials.
DATABASE_URL=jdbc:postgresql://localhost:5432/abhiai
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change-me

JWT_SECRET=replace-with-at-least-32-random-characters
ALLOWED_ORIGINS=http://localhost:3000

# Select and configure at least one provider for AI generation.
AI_PROVIDER=gemini
GEMINI_API_KEY=

# Optional providers. Keep unused values empty.
OPENAI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
OPENROUTER_API_KEY=

# Ollama is local-only by default. Set false on cloud deployments.
OLLAMA_ENABLED=true

# Development storage. Use s3 plus secret deployment variables in production.
MEDIA_STORAGE_TYPE=local
MEDIA_STORAGE_PATH=uploads
